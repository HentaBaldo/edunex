# ============================================================
# EduNex - Ortam Degiskenleri ORNEGI
# ============================================================
# KULLANIM:
#   1. Bu dosyayi kopyala -> `.env` olarak adlandir
#   2. Tum degerleri kendi degerlerinle doldur
#   3. `.env` git'e ASLA commit edilmemelidir (.gitignore'da)
# ============================================================

# --- GENEL ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- VERITABANI (Aiven MySQL) ---
DB_HOST=your-db-host.aivencloud.com
DB_PORT=23456
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace_with_real_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
MYSQL_ATTR_SSL_CA=

# --- JWT & SESSION ---
# Yeni secret uret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_with_32_byte_random_hex_string
SESSION_TIMEOUT=3600

# --- IYZICO (Marketplace) ---
# Sandbox: https://sandbox-api.iyzipay.com   |   Canli: https://api.iyzipay.com
IYZICO_API_KEY=sandbox-XXXXX
IYZICO_SECRET_KEY=sandbox-XXXXX
IYZICO_URI=https://sandbox-api.iyzipay.com

# --- BUNNY.NET ---
BUNNY_LIBRARY_ID=000000
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_ACCESS_KEY=replace_with_bunny_stream_api_key
BUNNY_API_TIMEOUT=30000
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_ACCESS_KEY=replace_with_bunny_storage_password
BUNNY_STORAGE_PULL_ZONE=https://your-pull-zone.b-cdn.net

# --- E-POSTA (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=replace_with_gmail_app_password
EMAIL_FROM=EduNex <noreply@yourdomain.com>

# --- RATE LIMIT (opsiyonel override) ---
LOGIN_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=10
COURSE_RATE_LIMIT=50

# --- YUKLEME ---
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE=4294967296
MULTER_MAX_FILE_SIZE=4294967296
VIDEO_PROCESSING_TIMEOUT=300000

# --- LOG ---
LOG_DIR=./logs
LOG_LEVEL=info

# --- DIKKAT ---
# NODE_TLS_REJECT_UNAUTHORIZED=0 ASLA EKLEME!
# Bu tum Node.js TLS dogrulamasini kapatir (iyzico, Bunny, e-posta dahil).
# DB icin gerekiyorsa sadece DB_SSL_REJECT_UNAUTHORIZED=false kullan.
